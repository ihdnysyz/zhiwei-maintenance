# 基础配置（本地开发与 Docker 部署通用）
# 大模型（Chat / Embedding）与 RAG 参数已改为在前端「系统管理 → 模型与 RAG」中在线配置
ADMIN_ORG=pilot
ADMIN_PASSWORD=
SECURE_COOKIE=false

# PostgreSQL 部署密码（仅 docker compose 部署必填，本地 SQLite 可留空）
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# 可选：企业集成与高级选项（均内置默认值，按需取消注释）
# DATABASE_URL=sqlite:///./.local/pilot.db
# OCR_LANG=chi_sim+eng
# MAX_UPLOAD_MIB=20
# RETENTION_DAYS=90
# EXPERT_SLA_DAYS=2
# ORG_TIMEZONE=Asia/Shanghai
# ID_USERINFO_URL=
# REGISTRY_URL=
# WORKORDER_ENABLED=false
# WORKORDER_URL=
# INTEGRATION_TOKEN=
